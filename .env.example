# ============================================
# ARSENAL APIK — ENVIRONMENT VARIABLES
# ============================================

# SMTP (untuk phishing)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Proxy (untuk rotasi IP)
PROXY_LIST=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080

# C2 Server
C2_URL=http://your-vps-ip:8080

# API Server
API_HOST=0.0.0.0
API_PORT=5001

# Dashboard
DASHBOARD_PORT=5001
